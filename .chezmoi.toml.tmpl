{{- $email := "alex.g.huang@gmail.com" -}}
{{- $shell := "fish" -}}
{{- $editor := "vscode" -}}

{{- if (and (eq .chezmoi.os "darwin") (eq $shell "fish")) -}}
[cd]
    command = "/opt/homebrew/bin/fish"
    args = ["-l", "-i"]
{{- end -}}

[data]
    email = {{ $email | quote }}

{{- if eq $editor "vscode" -}}
[edit]
    command = "code"
    args = ["--wait"]
{{- end -}}

[git]
    autoCommit = true
    commitMessageTemplate = "{{ promptString \"Commit message\" }}"
    autoPush = true

[github]
    refreshPeriod = "12h"
